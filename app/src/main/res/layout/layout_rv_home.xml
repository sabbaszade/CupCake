<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_def"
        android:layoutDirection="rtl"
        app:cardCornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_related"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:src="@mipmap/ic_launcher"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/writer_related"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_def"
                android:text="@string/writer"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@id/profile_related"
                app:layout_constraintTop_toTopOf="@id/profile_related" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/date_related"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/day_ago"
                app:layout_constraintStart_toStartOf="@+id/writer_related"
                app:layout_constraintBottom_toBottomOf="@id/profile_related"
                app:layout_constraintTop_toBottomOf="@id/writer_related" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/share_image"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="@dimen/margin_def"
                android:layout_marginEnd="@dimen/margin_def"
                android:src="@drawable/ic_bookmark_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title_related"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:maxLines="2"
                android:text="@string/description_row_home"
                android:textColor="@color/black"
                android:textDirection="rtl"
                android:textSize="@dimen/textSize_16"
                app:layout_constraintStart_toStartOf="@id/profile_related"
                app:layout_constraintTop_toBottomOf="@id/profile_related" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>