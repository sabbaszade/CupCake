<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.redstackapp.frg.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_navigation"
            app:destination="@id/navigation"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.redstackapp.frg.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_navigation"
            app:destination="@id/navigation"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <navigation
        android:id="@+id/navigation"
        app:startDestination="@id/baseFragment">
        <fragment
            android:id="@+id/homeFragment"
            android:name="com.example.redstackapp.frg.HomeFragment"
            android:label="HomeFragment"
            tools:layout="@layout/fragment_home" />
        <fragment
            android:id="@+id/baseFragment"
            android:name="com.example.redstackapp.frg.BaseFragment"
            android:label="fragment_base"
            app:startDestination="@id/action_baseFragment_to_homeFragment"
            tools:layout="@layout/fragment_base">
            <action
                android:id="@+id/action_baseFragment_to_homeFragment"
                app:destination="@id/homeFragment" />
            <action
                android:id="@+id/action_baseFragment_to_commerceFragment"
                app:destination="@id/commerceFragment" />
        </fragment>
        <action
            android:id="@+id/action_global_articleFragment"
            app:destination="@id/articleFragment" />
        <fragment
            android:id="@+id/commerceFragment"
            android:name="com.example.redstackapp.frg.CommerceFragment"
            android:label="fragment_commerce"
            tools:layout="@layout/fragment_commerce"></fragment>
        <action
            android:id="@+id/action_global_writeArticleFragment"
            app:destination="@id/writeArticleFragment" />
        <action
            android:id="@+id/action_global_profileFragment"
            app:destination="@id/profileFragment" />
    </navigation>
    <fragment
        android:id="@+id/articleFragment"
        android:name="com.example.redstackapp.frg.ArticleFragment"
        android:label="ArticleFragment">
        <action
            android:id="@+id/action_articleFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.redstackapp.frg.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.redstackapp.frg.ProfileFragment"
        android:label="ProfileFragment">
        <action
            android:id="@+id/action_profileFragment_to_writeArticleFragment"
            app:destination="@id/writeArticleFragment" />
        <action
            android:id="@+id/action_profileFragment_to_articleFragment"
            app:destination="@id/articleFragment" />
        <argument
            android:name="visibility"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/writeArticleFragment"
        android:name="com.example.redstackapp.frg.WriteArticleFragment"
        android:label="WriteArticleFragment">
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="desc"
            android:defaultValue=""
            app:argType="string" />


    </fragment>
</navigation>